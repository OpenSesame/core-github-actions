{
  "standard": {
    "id": "core-services-ai-ready-repository",
    "version": "0.14.1",
    "sourceRepository": "OpenSesame/core-services-ai-tooling",
    "sourceCommit": "41300ef002ee4af0dd9862d4f29c74c482dd61ad"
  },
  "surfaceDetection": {
    "npm": {
      "include": [
        "(^|/)package\\.json$"
      ]
    },
    "terraform": {
      "include": [
        "\\.tf$"
      ],
      "exclude": [
        "(^|/)\\.terraform/"
      ]
    }
  },
  "repository": {
    "requiredFiles": [
      {
        "paths": [
          "README.md"
        ]
      },
      {
        "paths": [
          "AGENTS.md"
        ]
      },
      {
        "paths": [
          ".gitignore"
        ]
      },
      {
        "paths": [
          ".github/CODEOWNERS",
          "CODEOWNERS",
          "docs/CODEOWNERS"
        ]
      },
      {
        "paths": [
          ".editorconfig"
        ]
      },
      {
        "paths": [
          ".vscode/extensions.json"
        ]
      },
      {
        "paths": [
          ".vscode/settings.json"
        ]
      }
    ],
    "committedFiles": [
      {
        "id": "terraform-working-directory",
        "description": "a Terraform working directory",
        "include": [
          "(^|/)\\.terraform/"
        ]
      },
      {
        "id": "terraform-state",
        "description": "Terraform state",
        "include": [
          "\\.tfstate(?:\\..+)?$"
        ]
      },
      {
        "id": "terraform-plan",
        "description": "a saved Terraform plan",
        "include": [
          "\\.tfplan(?:\\.json)?$",
          "(^|/)(?:tfplan|plan\\.out)$"
        ]
      },
      {
        "id": "terraform-variable-values",
        "description": "Terraform variable values",
        "include": [
          "\\.tfvars(?:\\.json)?$"
        ]
      },
      {
        "id": "terraform-local-credentials",
        "description": "Terraform CLI credentials",
        "include": [
          "(^|/)(?:credentials\\.tfrc\\.json|\\.terraformrc|terraform\\.rc)$"
        ]
      },
      {
        "id": "local-environment",
        "description": "a local .env file",
        "include": [
          "(^|/)\\.env(?:\\.[^/]+)?$"
        ],
        "exclude": [
          "\\.env\\.(?:example|sample|template|tpl)$"
        ]
      },
      {
        "id": "private-key-or-certificate",
        "description": "a private key or certificate",
        "include": [
          "\\.(?:cer|crt|der|key|p12|pem|pfx|ppk)$",
          "(^|/)(?:id_rsa|id_dsa|id_ecdsa|id_ed25519)$"
        ]
      },
      {
        "id": "cloud-credentials",
        "description": "cloud credentials",
        "include": [
          "(^|/)\\.aws/credentials$",
          "(^|/)application_default_credentials\\.json$"
        ]
      }
    ],
    "editorConfig": {
      "path": ".editorconfig",
      "preamble": {
        "root": "true"
      },
      "sections": {
        "*": {
          "charset": "utf-8",
          "end_of_line": "lf",
          "indent_size": "2",
          "indent_style": "space",
          "insert_final_newline": "true",
          "trim_trailing_whitespace": "true"
        },
        "*.md": {
          "trim_trailing_whitespace": "false"
        }
      },
      "conditionalSections": [
        {
          "include": [
            "(^|/)Makefile$"
          ],
          "section": "Makefile",
          "properties": {
            "indent_style": "tab"
          }
        }
      ]
    },
    "vscode": {
      "extensionsPath": ".vscode/extensions.json",
      "settingsPath": ".vscode/settings.json",
      "extensions": {
        "all": [
          "editorconfig.editorconfig",
          "streetsidesoftware.code-spell-checker"
        ],
        "gha": [
          "github.vscode-github-actions",
          "redhat.vscode-yaml"
        ],
        "terraform": [
          "hashicorp.terraform"
        ],
        "markdown": [
          "davidanson.vscode-markdownlint"
        ],
        "shell": [
          "timonwong.shellcheck",
          "foxundermoon.shell-format"
        ],
        "js": [
          "dbaeumer.vscode-eslint",
          "esbenp.prettier-vscode"
        ]
      },
      "settings": {
        "all": [
          {
            "editor.formatOnSave": true,
            "editor.rulers": [
              100
            ]
          }
        ],
        "terraform": [
          {
            "[terraform]": {
              "editor.defaultFormatter": "hashicorp.terraform"
            },
            "[terraform-vars]": {
              "editor.defaultFormatter": "hashicorp.terraform"
            }
          }
        ],
        "markdown": [
          {
            "[markdown]": {
              "editor.defaultFormatter": null
            }
          }
        ],
        "shell": [
          {
            "[shellscript]": {
              "editor.defaultFormatter": "foxundermoon.shell-format"
            }
          }
        ],
        "js": [
          {
            "editor.defaultFormatter": "esbenp.prettier-vscode",
            "prettier.requireConfig": true,
            "yaml.format.enable": false,
            "eslint.format.enable": false,
            "[javascript]": {
              "editor.defaultFormatter": "esbenp.prettier-vscode"
            },
            "[javascriptreact]": {
              "editor.defaultFormatter": "esbenp.prettier-vscode"
            },
            "[typescript]": {
              "editor.defaultFormatter": "esbenp.prettier-vscode"
            },
            "[typescriptreact]": {
              "editor.defaultFormatter": "esbenp.prettier-vscode"
            },
            "[json]": {
              "editor.defaultFormatter": "esbenp.prettier-vscode"
            },
            "[jsonc]": {
              "editor.defaultFormatter": "esbenp.prettier-vscode"
            },
            "[yaml]": {
              "editor.defaultFormatter": "esbenp.prettier-vscode"
            },
            "editor.codeActionsOnSave": {
              "source.fixAll.eslint": "always"
            }
          }
        ]
      }
    },
    "toolConfigs": {
      "terraform": [
        {
          "tool": "tflint",
          "paths": [
