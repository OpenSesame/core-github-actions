  "githubActions": {
    "workflowPattern": "^\\.github/workflows/[^/]+\\.ya?ml$",
    "actionPattern": "^\\.github/actions/(?:[^/]+/)+action\\.ya?ml$",
    "ciWorkflow": {
      "path": ".github/workflows/on_push_ci.yml",
      "requiredTriggers": [
        "push",
        "pull_request",
        "workflow_dispatch"
      ],
      "dispatchRevisionInput": "commit-identifier",
      "contextJob": "ci-context",
      "contextRevision": "${{ inputs.commit-identifier }}",
      "jobRevision": "${{ needs.ci-context.outputs.commit-identifier }}",
      "jobCondition": "needs.ci-context.outputs.should-run-ci == 'true'",
      "jobs": [
        {
          "id": "ci-context",
          "name": "CI Context",
          "checks": [
            "CI Context / Resolve"
          ],
          "uses": [
            "workflows/resolve_ci_context"
          ]
        },
        {
          "id": "app-ci",
          "name": "App CI",
          "namePattern": "^App CI(?: \\([^()]+\\))?$",
          "checks": [
            "App CI (<package>)"
          ],
          "surfaces": [
            "npm"
          ],
          "requiredWithScripts": [
            "build",
            "test"
          ]
        },
        {
          "id": "dependency-audit",
          "name": "Dependency Audit",
          "checks": [
            "Dependency Audit / Audit"
          ],
          "uses": [
            "workflows/run_npm_audit"
          ],
          "surfaces": [
            "npm"
          ],
          "waivable": true
        },
        {
          "id": "repo-checks",
          "name": "Repo Checks",
          "checks": [
            "Repo Checks / Detect",
            "Repo Checks / Standard / Validate",
            "Repo Checks / Summary"
          ],
          "uses": [
            "workflows/run_repo_checks"
          ],
          "permissions": {
            "contents": "read"
          },
          "secrets": [
            "ORG_READ_ONLY_SSH_KEY"
          ]
        },
        {
          "id": "terraform",
          "name": "Terraform",
          "checks": [
            "Terraform / <env> / Validate Plan"
          ],
          "uses": [
            "workflows/tf_validate_plan_env_roots",
            "workflows/tf_validate_plan_single_root"
          ],
          "surfaces": [
            "terraform"
          ]
        },
        {
          "id": "semgrep",
          "name": "Semgrep",
          "checks": [
            "Semgrep / Scan"
          ],
          "uses": [
            "workflows/run_semgrep_scan"
          ]
        },
        {
          "id": "sonar",
          "name": "Sonar",
          "checks": [
            "Sonar / Scan"
          ],
          "uses": [
            "workflows/run_sonar_scan"
          ],
          "waivable": true
        }
      ],
      "resultJob": {
        "id": "ci-result",
        "name": "CI Result",
        "if": "${{ !cancelled() && needs.ci-context.outputs.should-run-ci != 'false' }}",
        "action": "actions/check-ci-result",
        "stepName": "Check CI job results",
        "with": {
          "needs-json": "${{ toJSON(needs) }}"
        }
      }
    },
    "coreGithubActions": {
      "repository": "OpenSesame/core-github-actions",
      "minimumReleases": {
        "actions/pr-open-check": "2.1.0",
        "workflows/resolve_ci_context": "1.0.0",
        "workflows/run_npm_audit": "1.0.0",
        "workflows/run_sonar_scan": "2.0.0",
        "actions/run-semgrep": "2.0.0",
        "workflows/run_semgrep_scan": "2.0.0",
        "workflows/tf_validate_plan_env_roots": "1.0.0",
        "workflows/tf_validate_plan_single_root": "1.0.0",
        "workflows/run_infra_ci": "1.0.1",
        "workflows/run_repo_checks": "1.0.2",
        "actions/resolve-feature-workspace": "1.0.0",
        "actions/configure-aws-oidc": "1.0.2",
        "actions/check-ci-result": "1.0.0",
        "workflows/trigger_workflow_and_wait": "1.0.0",
        "workflows/tf_apply": "0.2.1",
        "workflows/deploy_environment": "0.3.1",
        "workflows/deploy_thru_prod": "0.3.1"
      }
    },
    "runner": {
      "label": "ubuntu-26.04",
      "forbiddenLabels": [
        "ubuntu-latest"
      ]
    },
    "npmInstall": {
      "requiredFlag": "--ignore-scripts",
      "actionsRequiringInstallFalse": [
        "cypress-io/github-action"
      ]
    },
    "repoChecks": {
      "excludePattern": "(^|/)(\\.core-services|node_modules|\\.terraform|dist|build|coverage|vendor)/",
      "technologies": [
        {
          "id": "gha",
          "name": "GitHub Actions",
          "include": "^\\.github/(workflows/[^/]+|actions/.+/action)\\.ya?ml$",
          "miseTasks": [
            "lint:gha",
            "scan:gha"
          ]
        },
        {
          "id": "terraform",
          "name": "Terraform",
          "include": "\\.tf$",
          "miseTasks": [
            "init:terraform",
            "validate:terraform",
            "lint:terraform",
            "format:terraform",
            "scan:terraform"
          ]
        },
        {
          "id": "markdown",
          "name": "Markdown",
          "include": "\\.md$",
          "npmScripts": [
            "lint:markdown"
          ]
        },
        {
          "id": "shell",
          "name": "Shell",
          "include": "\\.(sh|bash|zsh)$",
          "shebang": "^#!\\s*(/usr/bin/env\\s+)?(/usr)?(/local)?(/bin/)?(sh|bash|zsh)(\\s|$)",
          "miseTasks": [
            "lint:shell",
            "format:shell"
          ]
        },
        {
          "id": "js",
          "name": "JS",
          "include": "\\.(js|mjs|cjs|jsx|ts|mts|cts|tsx)$",
          "npmScripts": [
            "lint:js",
            "format:prettier"
          ]
        }
      ],
      "miseTaskCommands": {
        "scan:gha": "\\bzizmor\\b[^\\n]*--offline",
        "init:terraform": "-lockfile=readonly"
      },
      "miseConfig": "mise.toml",
      "miseLock": "mise.lock",
      "lockPlatforms": [
        "linux-x64",
        "macos-arm64"
      ],
      "npmBackends": [
        "npm"
      ],
      "unplatformedBackends": [
        "pipx",
        "go",
        "cargo",
        "gem",
        "dotnet",
        "spm"
      ],
      "packageJson": "package.json",
      "nodeVersionFile": ".nvmrc",
      "npmLockFile": "package-lock.json",
      "aggregateScripts": [
        "lint",
        "format",
        "scan",
        "check"
      ],
      "checkScript": "check",
      "terraformLockFile": ".terraform.lock.hcl",
      "terraformModulePattern": "(^|/)modules/",
      "actionlintConfigPaths": [
