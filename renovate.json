{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":configMigration",
    ":pinDevDependencies",
    "abandonments:recommended",
    "schedule:nonOfficeHours",
    ":automergePr",
    ":automergeRequireAllStatusChecks"
  ],
  "dependencyDashboardAutoclose": true,
  "timezone": "America/Los_Angeles",
  "automergeSchedule": ["* 9-15 * * 2-4"],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Group and automerge all npm development dependency updates.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "groupName": "npm development dependencies",
      "groupSlug": "npm-dev-dependencies",
      "addLabels": ["dependencies", "v:untracked"],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Node in .nvmrc, the engines field, and mise tools only change this repository's own CI and tests, not a released component, so they take v:untracked.",
      "matchManagers": ["nvm", "mise", "custom.regex"],
      "addLabels": ["dependencies", "v:untracked"],
      "minimumReleaseAge": "7 days",
      "matchDepNames": ["!semgrep"]
    },
    {
      "description": "Same as above for the engines ranges in package.json.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "addLabels": ["dependencies", "v:untracked"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Automerge non-major tooling updates once every check passes.",
      "matchManagers": ["nvm", "mise", "custom.regex", "npm"],
      "matchDepTypes": ["engines", "tools"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Automerge non-major Node updates in .nvmrc.",
      "matchManagers": ["nvm", "custom.regex"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "matchDepNames": ["!semgrep"]
    },
    {
      "description": "Actions pinned in versioned workflows and actions need version labels and changelog entries that Renovate can't write. Their updates wait on the Dependency Dashboard; approving them opens one grouped pull request, to which a person adds the labels and changelogs before it merges.",
      "matchManagers": ["github-actions"],
      "dependencyDashboardApproval": true,
      "minimumReleaseAge": "7 days",
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "separateMajorMinor": false
    },
    {
      "description": "The default semgrep-version in run_semgrep_scan is part of a versioned workflow, so its updates join the batched GitHub Actions release.",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["semgrep"],
      "dependencyDashboardApproval": true,
      "minimumReleaseAge": "7 days",
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "separateMajorMinor": false
    },
    {
      "description": "The JavaScript actions run on the node24 runtime, so Node stays on the 24 release line.",
      "matchPackageNames": ["node"],
      "allowedVersions": "<25"
    },
    {
      "description": "Renovate can't read this private repository from here, so its updates are checked by hand in the batched releases.",
      "matchPackageNames": ["OpenSesame/gha-oidc-access"],
      "enabled": false
    },
    {
      "description": "Renovate looks up the mise binary that mise-action installs by its release tag without the v prefix and fails, so its version and checksum are updated by hand in the batched releases.",
      "matchDepNames": ["jdx/mise"],
      "matchDatasources": ["github-release-attachments"],
      "enabled": false
    },
    {
      "description": "Deprecated workflows and legacy root actions get no further updates.",
      "matchFileNames": [
        ".github/workflows/tf_validate_plan_*.yml",
        "build/**",
        "build-apply/**",
        "build-publish/**",
        "cleanup/**",
        "deploy/**",
        "select-branch-workspace/**",
        "semgrep/**",
        "tf-apply/**",
        "tf-plan/**",
        "tf-plan-comment/**"
      ],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": false,
    "labels": ["dependencies", "security"],
    "commitMessageSuffix": "[SECURITY]"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The default semgrep-version that run_semgrep_scan installs with pip, and its README.",
      "managerFilePatterns": [
        "/^\\.github/workflows/run_semgrep_scan\\.yml$/",
        "/^\\.github/workflows/READMES/run_semgrep_scan\\.md$/"
      ],
      "matchStrings": [
        "semgrep-version:\\n(?:\\s+\\w+: .*\\n)*?\\s+default: '(?<currentValue>\\d+\\.\\d+\\.\\d+)'",
        "\\| `semgrep-version`\\s+\\| `(?<currentValue>\\d+\\.\\d+\\.\\d+)`"
      ],
      "depNameTemplate": "semgrep",
      "datasourceTemplate": "pypi"
    }
  ]
}
