{
  "name": "core-github-actions",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@12.2.1",
  "description": "Core Team's reusable GitHub Actions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenSesame/core-github-actions.git"
  },
  "author": "Core Services Team @ OpenSesame",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=12.1.0 <13"
  },
  "homepage": "https://github.com/OpenSesame/core-github-actions#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@eslint/markdown": "8.0.3",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.10",
    "semgrep": "0.0.1"
  },
  "scripts": {
    "prepare": "husky install",
    "test": "jest",
    "watch": "jest --watch",
    "audit": "npm-run-all --continue-on-error audit:*",
    "audit:npm": "npm audit --audit-level=high",
    "lint": "npm-run-all --continue-on-error lint:*",
    "lint:js": "eslint *.js --ext .js,.json",
    "lint:gha": "mise run lint:gha",
    "lint-fix": "npm-run-all --continue-on-error lint-fix:*",
    "lint-fix:js": "eslint *.js --ext .js,.json --fix",
    "format": "npm-run-all --continue-on-error format:*",
    "format:prettier": "prettier --check './*.js' './*.mjs' './*.json' './*.md' 'scripts/**/*.js' '.github/actions/**/*.*'",
    "format-fix": "npm-run-all --continue-on-error format-fix:*",
    "format-fix:prettier": "prettier --write './*.js' './*.mjs' './*.json' './*.md' 'scripts/**/*.js' '.github/actions/**/*.*'",
    "scan": "npm-run-all --continue-on-error scan:*",
    "scan:semgrep": "semgrep --config=p/ci --config=p/security-audit --config=p/javascript ./*.js ./*.mjs ./*.json scripts/ .github/actions/",
    "scan:gha": "mise run scan:gha",
    "check": "npm-run-all --continue-on-error audit lint format test scan"
  }
}
